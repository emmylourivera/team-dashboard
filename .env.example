# Copy to .env (never commit it) or set these in your hosting platform.

NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/team_dashboard

# --- Sign-in -------------------------------------------------------------
# Put the app behind the company single sign-on proxy (oauth2-proxy, Google
# IAP, Cloudflare Access...). The proxy signs people in and passes their email
# in a header. The app must ONLY be reachable through that proxy.
AUTH_MODE=header
AUTH_EMAIL_HEADER=x-forwarded-email
AUTH_NAME_HEADER=x-forwarded-preferred-username
# Strongly recommended: a long random value the proxy adds to every request,
# so a request that skips the proxy is rejected.
AUTH_PROXY_SECRET_HEADER=x-proxy-secret
AUTH_PROXY_SECRET=
# Only these email domains may sign in (comma separated). Leave empty for any.
ALLOWED_EMAIL_DOMAINS=

# --- People --------------------------------------------------------------
# Workspace owners: manage People & roles and approve access requests.
OWNER_EMAILS=
# Editors: can use "View as" to preview every role.
EDITOR_EMAILS=
# Can sign in and look, but can't change anything (e.g. outside vendors).
READ_ONLY_EMAILS=

# --- Files ---------------------------------------------------------------
MAX_UPLOAD_MB=50

# --- AI features (print proof check, carton panel detection) -------------
# Leave empty to turn them off. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
